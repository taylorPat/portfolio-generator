{% extends "base.html.jinja" %}

{% block content %}

{# Use values directly from profile.yml (no template defaults) #}
{% set contact = contact if contact is defined else None %}

<div class="landing-split">
  <aside class="left-panel">
    <div class="left-content">
      <div class="profile-intro">
        <div class="profile-summary">
          {% if image_url %}
            <img class="profile-avatar" src="{{ image_url }}" alt="{{ name }}" />
          {% endif %}
          <h1>{{ name }}</h1>
          <h3 class="muted">{{ job_title }}</h3>
          <p class="about">{{ about }}</p>
        </div>
      </div>

      <div class="contact-block">
        {% set email = contact.email if contact is defined and contact is not none and contact.email is defined and contact.email else None %}
        {% set location_city = contact.location.city if contact is defined and contact is not none and contact.location is defined and contact.location.city is defined and contact.location.city else '' %}
        {% set location_country = contact.location.country if contact is defined and contact is not none and contact.location is defined and contact.location.country is defined and contact.location.country else '' %}

        {% if email %}
          <p class="contact-line">
            <span class="contact-label">Email</span>
            <a class="contact-link" href="mailto:{{ email }}">{{ email }}</a>
          </p>
        {% endif %}

        {% if location_city or location_country %}
          <p class="contact-line">
            <span class="contact-label">Location</span>
            <span class="contact-value">{% if location_city %}{{ location_city }}{% endif %}{% if location_city and location_country %}, {% endif %}{% if location_country %}{{ location_country }}{% endif %}</span>
          </p>
        {% endif %}

        {% if links is defined %}
        <div class="profile-links">
          {% for link in links %}
            <a class="btn small" href="{{ link.url }}" target="_blank" rel="noopener">{{ link.name | replace('_',' ') | title }}</a>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
  </aside>

  <div class="split-divider" aria-hidden="true"></div>

  <section class="right-panel">
    <div class="tabs">
      <nav class="tabs-nav" aria-label="Portfolio sections">
        <button class="tab-btn active" data-tab="skills">Core skills</button>
        <button class="tab-btn" data-tab="projects">Projects</button>
        <button class="tab-btn" data-tab="cv">CV / Experience</button>
      </nav>

      <div class="tabs-content">
        <div class="tab-panel plain-panel" id="skills" style="display:block">
          <div class="skills-columns">
            {# If `skills` provided in profile.yml, render grouped sections #}
            {% if skills is defined %}
              {% for skill in skills %}
              <div class="skill-section">
                <h4>{{ skill.name | capitalize }}</h4>
                <div class="skill-items">
                  {% for item in skill.attributes %}
                    <span class="skill-item" aria-hidden="true">{{ item }}</span>
                  {% endfor %}
                </div>
              </div>
              {% endfor %}
            {% elif skills is defined %}
              <div class="skill-section">
                <h4>Skills</h4>
                <div class="skill-items">
                  {% for item in skills %}
                    <span class="skill-item" aria-hidden="true">{{ item }}</span>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          </div>
        </div>

        <div class="tab-panel projects-panel" id="projects" style="display:none">
          <div class="skills-columns">
            {% if projects is defined %}
              {% for project in projects %}
              <div class="skill-section project-section">
                <div class="project-header">
                  <h4>{{ project.name }}</h4>
                  {% if project.link is defined %}
                    <a class="proj-btn github" href="{{ project.link.url }}" target="_blank" rel="noopener">{{ project.link.name }}</a>
                  {% endif %}
                </div>
                <div class="skill-items">
                  {% if project.attributes is defined %}
                    {% for attr in project.attributes %}
                      <span class="skill-item" aria-hidden="true">{{ attr }}</span>
                    {% endfor %}
                  {% endif %}
                </div>
              </div>
              {% endfor %}
            {% endif %}
          </div>
        </div>

        <div class="tab-panel plain-panel" id="cv" style="display:none">
          <div class="experience-list">
            {% if jobs is defined and jobs %}
              <div class="company-block">
                <h3 class="company-name">Jobs</h3>
                {% for company in jobs|reverse %}
                  <div class="exp-item">
                    <h4>{{ company.name }}</h4>
                    {% for station in company.stations|sort(attribute='start_year', reverse=True) %}
                      <div class="exp-entry">
                        <p class="muted">
                          {% set sy = station.start_year %}
                          {% set ey = station.end_year %}
                          {% if sy or ey %}
                            {{ sy }} - 
                            {% if ey is not none %}
                              {{ ey }}
                            {% else %}
                              Present
                            {% endif %}
                          {% endif %}
                        </p>
                        <p><strong>{{ station.role }}</strong></p>
                        {% if station.activities %}
                          <p>{{ station.activities }}</p>
                        {% endif %}
                      </div>
                    {% endfor %}
                  </div>
                {% endfor %}
              </div>
            {% endif %}

            {% if education is defined and education %}
              <div class="company-block">
                <h3 class="company-name">Education</h3>
                {% for company in education|reverse %}
                  <div class="exp-item">
                    <h4>{{ company.name }}</h4>
                    {% for station in company.stations|sort(attribute='start_year', reverse=True) %}
                      <div class="exp-entry">
                        <p class="muted">
                          {% set sy = station.start_year %}
                          {% set ey = station.end_year %}
                          {% if sy or ey %}
                            {{ sy }} - 
                            {% if ey is not none %}
                              {{ ey }}
                            {% else %}
                              Present
                            {% endif %}
                          {% endif %}
                        </p>
                        <p><strong>{{ station.role }}</strong></p>
                        {% if station.activities %}
                          <p>{{ station.activities }}</p>
                        {% endif %}
                      </div>
                    {% endfor %}
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>

      </div>
    </div>
  </section>
</div>

{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function(){
  const buttons = document.querySelectorAll('.tab-btn');
  buttons.forEach(btn => btn.addEventListener('click', function(){
    document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    const tab = btn.dataset.tab;
    document.querySelectorAll('.tab-panel').forEach(p=>p.style.display='none');
    document.getElementById(tab).style.display='block';
  }));
});
</script>
{% endblock %}
